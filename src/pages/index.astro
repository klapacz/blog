---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="prose max-w-content mx-auto px-4">
      <p>
        Hi! I'm Korneliusz Łapacz, a 23-year-old full stack developer from
        Poland, specializing in Typescript and React. I've been working in the
        field for 4 years. I graduated from a technical high school with a focus
        on IT.
      </p>
    </main>
    <Footer />
  </body>
</html>
